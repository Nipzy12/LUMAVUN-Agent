# API: salin ke apps/api/.env
HOST=127.0.0.1
PORT=3000
# Buat dengan: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_API_TOKEN=replace-with-a-random-64-character-hex-token
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Opsional: dipakai bila klien belum memilih model.
AI_DEFAULT_MODEL=
# Origin web yang boleh mengakses backend; kosong berarti browser CORS diblokir.
CORS_ORIGINS=
