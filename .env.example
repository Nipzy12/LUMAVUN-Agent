# Luma Office — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env or any real secrets.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite path is relative to the project root. Change to a reachable path on
# Windows if you run the server from a different working directory.
DATABASE_URL=sqlite:///./luma.db

# ---------------------------------------------------------------------------
# AI Providers (optional — Phase 1 does not require any provider)
# ---------------------------------------------------------------------------
# Add provider keys here when you integrate a provider. Every key is optional
# and must never be hardcoded in source code.
# Example placeholders — replace with real values only in your private .env.
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# Any other provider-specific variables go below.
