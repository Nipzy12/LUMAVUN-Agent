# Luma Office — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env or any real secrets.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite path is relative to the project root. Change to a reachable path on
# Windows if you run the server from a different working directory.
DATABASE_URL=sqlite:///./luma.db

# ---------------------------------------------------------------------------
# AI Providers (optional — Phase 1 does not require any provider)
# ---------------------------------------------------------------------------
# Add provider keys here when you integrate a provider. Every key is optional
# and must never be hardcoded in source code.
# Example placeholders — replace with real values only in your private .env.
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# Any other provider-specific variables go below.

# Phase 3.1: explicit owner-only text generation. Disabled by default.
LOCAL_OWNER_TOKEN=
# Supported values: unavailable, openai, openrouter
AI_PROVIDER=unavailable
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=1024

# Phase 3.2: stable server-side owner identity (keep stable when rotating token).
LOCAL_OWNER_ID=local-owner
# History text limits; set either value to 0 to disable history in prompts.
CONVERSATION_CONTEXT_MAX_MESSAGES=20
CONVERSATION_CONTEXT_MAX_CHARS=12000

# Phase 3.2.1 direct Chat: empty model mappings fall back to provider's model above.
OPENAI_CHAT_LOW_MODEL=
OPENAI_CHAT_MEDIUM_MODEL=
OPENAI_CHAT_HIGH_MODEL=
OPENROUTER_CHAT_LOW_MODEL=
OPENROUTER_CHAT_MEDIUM_MODEL=
OPENROUTER_CHAT_HIGH_MODEL=
CHAT_LOW_TOKENS=256
CHAT_MEDIUM_TOKENS=1024
CHAT_HIGH_TOKENS=2048
# Exact server-approved vision model IDs; adjust for your provider's capabilities.
CHAT_IMAGE_MODELS=gpt-4o-mini,openai/gpt-4o-mini
# Private, application-managed storage. Never serve this directory publicly.
CHAT_ATTACHMENT_DIR=./private_uploads

# Only unused/unlinked attachments expire; linked conversation files are retained.
CHAT_ATTACHMENT_TTL_HOURS=24

# Phase 3.2.2 Image Studio (explicit opt-in, uses existing provider API keys).
# Supported: unavailable, openai, openrouter. Separate from text AI_PROVIDER.
IMAGE_PROVIDER=unavailable
OPENAI_IMAGE_MODEL=gpt-image-2
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
IMAGE_STORAGE_DIR=./private_images
IMAGE_TIMEOUT_SECONDS=180
IMAGE_MAX_OUTPUT_BYTES=4194304
IMAGE_MAX_PER_GENERATION=1
IMAGE_MAX_CONCURRENT=2
IMAGE_ORPHAN_TTL_HOURS=24

# Phase 3.2.3 Advanced Studio: no ML/GPU dependency in the core application.
COMFYUI_ENABLED=false
COMFYUI_LOCAL_URL=http://127.0.0.1:8188
COMFYUI_REMOTE_URL=
# Exact origins; remote endpoints must use HTTPS. No browser-supplied endpoints.
COMFYUI_TRUSTED_ORIGINS=http://127.0.0.1:8188
COMFYUI_TOKEN=
# Server-controlled JSON metadata; example remains disabled until operator review.
COMFYUI_MANIFEST=
# Optional local ComfyUI/models root to independently verify checkpoint/LoRA hashes.
COMFYUI_MODEL_ROOT=
COMFYUI_DEFAULT_MODEL=
COMFYUI_TIMEOUT_SECONDS=300
COMFYUI_WS_PROGRESS=false
STUDIO_MAX_PIXELS=1048576
STUDIO_MAX_STEPS=40

# Private Studio is opt-in, single-owner and disabled by default.
PRIVATE_STUDIO_ENABLED=false
PRIVATE_STUDIO_ALLOW_CLOUD=false
PRIVATE_STUDIO_UNLOCK_MINUTES=15
