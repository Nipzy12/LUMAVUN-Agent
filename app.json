{
  "expo": {
    "name": "LUMAVUN",
    "slug": "lumavun-agent",
    "scheme": "lumavun",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.lumavun.agent",
      "versionCode": 2,
      "edgeToEdgeEnabled": true,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1020"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-document-picker"
    ],
    "extra": {
      "brand": "LUMAVUN"
    },
    "icon": "./assets/icon.png"
  }
}
