{
  "expo": {
    "name": "LUMAVUN",
    "slug": "lumavun-agent",
    "scheme": "lumavun",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.lumavun.agent",
      "versionCode": 4,
      "edgeToEdgeEnabled": true,
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1020"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-document-picker",
      [
        "llama.rn",
        {
          "enableOpenCL": false,
          "forceCxx20": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LUMAVUN meminta akses lokasi hanya ketika kamu mengaktifkannya."
        }
      ],
      "expo-calendar",
      "expo-build-properties"
    ],
    "extra": {
      "brand": "LUMAVUN"
    },
    "icon": "./assets/icon.png"
  }
}
