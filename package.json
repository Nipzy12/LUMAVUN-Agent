{
  "name": "lumavun-agent",
  "version": "0.3.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "doctor": "expo install --check",
    "prebuild": "expo prebuild --platform android",
    "generate:assets": "node scripts/generate-assets.mjs",
    "postinstall": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "expo": "~58.0.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "expo-file-system": "*",
    "expo-document-picker": "*",
    "expo-secure-store": "*",
    "expo-sqlite": "*",
    "expo-clipboard": "*",
    "expo-sharing": "*",
    "react-native-safe-area-context": "*",
    "@expo/vector-icons": "*",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/react": "^19.2.0",
    "tsx": "^4.20.6",
    "@types/node": "^22.18.0",
    "sharp": "^0.34.5"
  }
}
